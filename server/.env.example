PORT=5000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sprintify_db
JWT_SECRET=sprintify_super_secret_jwt_key_2026
CLIENT_ORIGIN=http://localhost:3000

# Optional 8x8 JaaS (Jitsi as a Service) Configuration
# If configured, meetings will issue signed RS256 JWT tokens for 8x8.vc JaaS iframe embedding.
# If omitted, Sprintify automatically falls back to public Jitsi Meet (meet.jit.si).
# JAAS_APP_ID=vpaas-magic-cookie-xxxxxx
# JAAS_KID=vpaas-magic-cookie-xxxxxx/key-id-xxxxxx
# JAAS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Optional AI Task Assistant Configuration (Gemini or OpenAI)
# If omitted or unconfigured, the AI Assist features degrade gracefully and buttons are hidden.
# AI_PROVIDER=gemini # 'gemini' or 'openai' (default: gemini)
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-2.5-flash # Check provider documentation for latest available models
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini

# Optional Email Notification Configuration (Nodemailer)
# If omitted, email sending is skipped and in-app notifications continue to function normally.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# MAIL_FROM="Sprintify App <no-reply@sprintify.local>"
# FRONTEND_URL=http://localhost:3000
